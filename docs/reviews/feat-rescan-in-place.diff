+        between(score(fail(dns, 6)), score(fail(dns, 6)), UserScan.CheckAgain(dns))
+    )
+
+    @Test
+    fun `no change back from a manual review's settings is no change`() = assertEquals(
+        ScanOutcome.NoChange(94),
