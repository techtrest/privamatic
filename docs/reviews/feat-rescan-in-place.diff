+        between(score(fail(lock, 11), fail(dns, 6)), score(pass(lock)))
+    )
+
+    @Test
+    fun `two checks that disappear are not called fixed`() = assertEquals(
+        ScanOutcome.Gain(17, 100, hasLosses = false),
+        between(score(fail(lock, 11), fail(dns, 6)), score())
+    )
+
+    @Test
